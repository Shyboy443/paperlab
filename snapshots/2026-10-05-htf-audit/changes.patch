+@pytest.mark.parametrize("side,d", [("long", 1), ("short", -1)])
+def test_policies_distinguish_ranges_breakouts_and_pullbacks(side, d):
+    neutral = {"h4": 0, "d1": 0, "h4_slope_atr": 0.0}
+    daily = {"h4": 0, "d1": d, "h4_slope_atr": 0.0}
