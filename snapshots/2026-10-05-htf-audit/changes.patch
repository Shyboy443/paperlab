+def _trend(cs: Sequence[Candle], n: int, k: int) -> tuple[int, float]:
+    e = ema([c.close for c in cs], n)
+    tr = [max(c.high - c.low, abs(c.high - p.close), abs(c.low - p.close)) for p, c in zip(cs, cs[1:])]
