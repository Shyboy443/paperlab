+    def _entry_at_fill(self, order: Order, sig: Signal, decision: Any, meta: StrategyMeta,
+                       res: ReplayResult, price: float, *, maker: bool = False,
+                       counterfactual: bool = False) -> bool:
+        """Recheck a queued entry against current capital and its executable price.
+
+        Keep the approved risk budget and leverage; never enlarge an order or rerun
+        an LLM/sizing policy. A signal's cooldown does not cancel its own order.
+        """
+        reject = lambda why: self._reject_pending(order, res, why)
+        st = self.risk.state
+        if not counterfactual and st.daily_halted:
+            return reject("fill_daily_halt")
+        if not counterfactual and (st.killed or not st.engine_running or not meta.enabled
+                                   or meta.halted or meta.id in st.halted_strategies):
+            return reject("fill_halted")
+        held = self.portfolio.positions_of(meta.id)
+        if not counterfactual and len(held) >= max(1, meta.max_positions):
+            return reject("fill_max_positions")
+        if not counterfactual and any(p.symbol == sig.symbol and p.leg == sig.leg for p in held):
+            return reject("fill_already_in_symbol")
+        if not math.isfinite(price) or price <= 0:
+            return reject("fill_no_price")
+        long = sig.side == "long"
+        if (long and price <= sig.stop) or (not long and price >= sig.stop):
+            return reject("gap_past_stop")
+        if sig.take_profits:
+            tp1 = sig.take_profits[0].price
+            if (long and price >= tp1) or (not long and price <= tp1):
+                return reject("gap_past_tp1")
+        prices = {**self.ctx.prices, sig.symbol: price}
+        equity = self.portfolio.wallet_equity(meta.id, prices)
+        available = self.portfolio.available(meta.id, prices)
+        total = self.portfolio.total_equity(prices)
+        dist = abs(price - sig.stop)
+        if dist / price < self.settings.min_stop_bps / 1e4:
+            return reject("fill_stop_too_tight")
+        if 2.0 * self.settings.taker_fee * price > self.settings.max_fee_share_of_r * dist + 1e-12:
+            return reject("fill_fee_gt_r")
+        if meta.min_rr > 0:
+            rr = dataclasses.replace(sig, entry_price=price).rr()
+            if rr is None or rr < meta.min_rr - 1e-9:
+                return reject("fill_rr_below_min")
+        budget = order.meta.setdefault("approved_risk_usd", decision.risk_usd)
+        if self.max_risk_pct is not None:
+            budget = min(budget, self.max_risk_pct * max(0.0, equity))
+        rate = self.settings.maker_fee if maker else self.settings.taker_fee
+        lev = max(1, decision.leverage)
+        gross_room = self.settings.max_total_notional_mult * total - self.portfolio.gross_notional(prices)
+        sign = 1 if long else -1
+        net_room = self.settings.max_net_notional_mult * total / price - sign * self.portfolio.net_qty(sig.symbol)
+        qty = min(order.qty, budget / dist, max(0.0, available) / (price * (1.0 / lev + rate)),
+                  max(0.0, gross_room) / price, max(0.0, net_room))
+        rules = self.rules[sig.symbol]
+        qty = rules.round_qty_down(qty) if rules.step else qty
+        minimum = rules.min_notional * max(1.0, self.settings.min_notional_safety_multiplier)
+        if qty <= 0 or qty < rules.min_qty - 1e-12 or qty * price < minimum - 1e-9:
+            return reject("fill_insufficient_capacity")
+        order.qty = decision.qty = qty
+        decision.notional = qty * price
+        decision.margin = decision.notional / lev
+        decision.risk_usd = qty * dist
+        if order.meta.get("sizing"):
+            order.meta["sizing"].update(risk_usd=decision.risk_usd,
+                                       risk_pct=decision.risk_usd / equity if equity > 0 else None)
+        return True
