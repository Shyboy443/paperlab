# PaperLab configuration. Copy to paperlab/.env  (the app loads ONLY this file, never a parent .env)
# Venue: FUTURES_TESTNET | FUTURES_DEMO | SPOT_TESTNET   (live hosts are refused)
MODE=FUTURES_TESTNET

# Testnet / demo API key pair. Leave empty for DRY_RUN=true (public market data needs no key).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Dashboard login: user "admin", this password. Required unless ALLOW_NO_AUTH=true (local only).
DASHBOARD_PASSWORD=change-me

SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
ENGINE_ENABLED=true

# true  = simulated fills in the virtual book, no exchange orders (safe default)
# false = same virtual book PLUS real testnet orders through the net-delta router (needs keys)
DRY_RUN=true

# Every strategy gets its OWN isolated book of this many USDT. Paper total = 20 x this.
# Wallets never share cash, margin or PnL, and all 20 strategies are armed from boot.
STRATEGY_STARTING_BALANCE=100
DEFAULT_LEVERAGE=20

# Storage. Defaults to <project>/data locally and to the Railway volume when RAILWAY_VOLUME_MOUNT_PATH is set.
# DATA_DIR=/data

# Server bind (Railway injects PORT; the Dockerfile sets BIND_HOST=0.0.0.0)
# PORT=8540
# BIND_HOST=127.0.0.1

ALLOW_NO_AUTH=false
AUTO_RESUME_AFTER_HALT=false
LOG_LEVEL=INFO

# --- aggression + survival knobs -------------------------------------------------------------
# A book that loses 25% of its 100 USDT is flattened, recorded, and (by default) RESPAWNED at 100
# as a new "life" so all 20 keep competing for the whole soak. Lives are capped per UTC day.
AUTO_RESPAWN_HALTED=true
MAX_LIVES_PER_DAY=8
# Risk per entry as a fraction of THAT strategy's own wallet.
RISK_PER_TRADE_PCT=0.04
# Reject stops tighter than this many bps of price (stops a 2-tick stop becoming huge size).
MIN_STOP_BPS=8
# Separate 20-stock Alpaca strategy: authorized allocation cap, USD.
# Default paused. This amount is too small for twenty $1 initial orders.
STOCK_TREND_MAX_ALLOCATION_USD=9.50

